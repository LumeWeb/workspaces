# Pinned upstream inputs for the php-caddy base image.
# These mirror the ARG defaults in Dockerfile; keep both in sync. Bump by
# reviewing the upstream changelogs, updating both files, then running
# `make deps-verify` and the build/verify matrix.

# PHP (current stable series at implementation time; pinned by digest)
PHP_VERSION=8.5.10
PHP_BASE=php:8.5.10-fpm-bookworm
PHP_BASE_DIGEST=sha256:81b9c405b013ebda0c9b8cd7a1a61424cf3627ca96348d93752a9b0539ce9a25

# Caddy (current stable; pinned by release and per-arch sha512 from
# caddy_2.11.4_checksums.txt)
CADDY_VERSION=2.11.4
CADDY_SHA512_AMD64=1c6f5404f3622e46d401d81f4af59677d46b886229c6694d60fd936b87c72d3bb5d1fcf42b55c8d555769fa75acf434ab618fc7e0df2c79cf8512ee580d38d06
CADDY_SHA512_ARM64=c43c62b7b583b31c682b3c3e1a31cf03759fbab01dcb0fc7d7fc3a5ce1bef43403583e26133920634a730a9fe31dae1386af4d3f9f3fc19fcc2c29ebf19de235
