# Pinned upstream inputs for the WordPress image.
# Mirrors the ARG defaults in Dockerfile; keep both in sync.

# Current stable WordPress release at implementation time, pinned to the exact
# sha256 of the official release archive (wordpress-7.1.tar.gz).
WORDPRESS_VERSION=7.1
WORDPRESS_SHA256=05a5f89138f632b7329f1202f2a0553c5f7fe4daf8e4b9ca7ebae9b9466b9e86

# WP-CLI (baked into the image and pinned to its exact release sha512). wp-init
# uses it for `wp config create`, `wp core install` and the per-boot admin
# password converge, so verification/most post-install needs no separate copy.
WP_CLI_VERSION=2.12.0
WP_CLI_SHA512=be928f6b8ca1e8dfb9d2f4b75a13aa4aee0896f8a9a0a1c45cd5d2c98605e6172e6d014dda2e27f88c98befc16c040cbb2bd1bfa121510ea5cdf5f6a30fe8832

# Go builder image used to compile the workspace-init CLI (pinned by exact
# digest; multi-arch manifest-list digest). Bump together with the Go version
# the workspace-init module's go.mod requires.
GO_BASE=golang:1.26.1-bookworm
GO_BASE_DIGEST=sha256:ab3d6955bbc813a0f3fdf220c1d817dd89c0b3f283777db8ece4a32fe7858edd
